NODE_ENV=development
APP_NAME=vibe-api
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGINS=http://localhost:5173

# Server safety
API_MAX_BODY_MB=1
API_IDLE_TIMEOUT_SECONDS=30
SHUTDOWN_TIMEOUT_MS=10000
OUTBOUND_HTTP_TIMEOUT_MS=10000
TRUST_PROXY_HEADERS=false

# Rate limiting (process-local baseline; replace store for distributed deployments)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Optional until a feature needs persistence
# Docker Compose PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibe
# Supabase local alternative (after `bun x supabase start`):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase Cloud: replace DATABASE_URL with the project's PostgreSQL connection string.

# JWT auth module (production must override these with 32+ character random secrets)
JWT_ACCESS_SECRET=change-me-with-a-long-random-secret
JWT_REFRESH_SECRET=change-me-with-another-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_PRUNE_INTERVAL_SECONDS=21600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
