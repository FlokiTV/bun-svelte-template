{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "paths": {
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"]
    },
    "types": ["@rsbuild/core/types"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "rsbuild.config.ts", "rstest.config.ts"]
}
