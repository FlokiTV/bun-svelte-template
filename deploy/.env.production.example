# TEMPLATE ONLY. DO NOT DEPLOY THIS FILE.
# Domain must resolve to the deployment host. TLS is managed by Caddy.
SITE_DOMAIN=app.example.com
NODE_ENV=production
APP_NAME=replace-with-product-name
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGINS=https://app.example.com

# Use managed Postgres with backups and private access.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE?sslmode=require

# Generate unique random values (at least 32 characters each).
JWT_ACCESS_SECRET=REPLACE_WITH_UNIQUE_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_REFRESH_SECRET
JWT_ISSUER=replace-with-product-name:production
JWT_ACCESS_AUDIENCE=replace-with-product-name:web
JWT_REFRESH_AUDIENCE=replace-with-product-name:refresh

# Secure same-origin cookies over HTTPS.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Do not permit public sign-ups until identity recovery/abuse checks are ready.
AUTH_REGISTRATION_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false
TRUST_PROXY_HEADERS=false
RATE_LIMIT_ENABLED=true
AUTH_SESSION_PRUNE_INTERVAL_SECONDS=21600
